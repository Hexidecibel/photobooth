schema = 1

[defaults]
target_vault = "cush"
target_item = "{project}"
field_template = "{key}"

[secrets]
DEBUG = { ref = "op://cush/photobooth/debug", target_vault = "cush", target_item = "photobooth" }
HOST = { ref = "op://cush/photobooth/host", target_vault = "cush", target_item = "photobooth" }
PORT = { ref = "op://cush/photobooth/port", target_vault = "cush", target_item = "photobooth" }
