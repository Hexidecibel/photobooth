schema = 1

[defaults]
target_vault = "cush"
target_item = "{project}"
field_template = "{key}"

[secrets]
DEBUG = { ref = "inf://dev/photobooth/DEBUG", target_vault = "cush", target_item = "photobooth" }
HOST = { ref = "inf://dev/photobooth/HOST", target_vault = "cush", target_item = "photobooth" }
PORT = { ref = "inf://dev/photobooth/PORT", target_vault = "cush", target_item = "photobooth" }
